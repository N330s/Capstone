          size="0.009 0.006175 0.0034" rgba="0.82 0.81 0.76 1"/>
    <geom name="socket_right" type="box" pos="0.009 0.013825 0"
          size="0.009 0.006175 0.0034" rgba="0.82 0.81 0.76 1"/>
