# Copy to repository-root .env and edit. Never put credentials in this file.
# Linux/WSL: use the Linux filesystem, not /mnt/c, for training I/O if possible.
OPENARM_STORAGE=/srv/openarm-storage
OPENARM_UID=1000
OPENARM_GID=1000
OPENARM_GPU_ID=0
# Optional: replace the tag with a verified python image digest after lab qualification.
# OPENARM_PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:...
